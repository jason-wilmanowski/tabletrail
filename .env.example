# when clone this repository rename this file -> .env


# DB-Container Settings
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# FastAPI Port
FASTAPI_PORT=

# SQLAlchemy DB_URL (starting with postgresql+asyncpg: for async operations)
DATABASE_URL=

# Frontend URL
FRONTEND_URL=
FRONTEND_PORT=

# AES-256 key (base64, 32 bytes) for encrypting stored credentials (generate: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())")
ENCRYPTION_KEY=
